{
  "name": "robopath",
  "version": "1.0.0",
  "description": "RoboPath — Interactive 3D Robot Motion Planning Simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.11",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.11",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.454.0",
    "mongoose": "^8.8.1",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "three": "^0.169.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "mongodb-memory-server": "^10.4.3",
    "postcss": "^8.5.31",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
