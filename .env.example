# ============================================================================
# ROBOPATH 3D — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to `.env` and populate with your own values.
# NEVER commit real secrets, API keys, or database credentials to Git.
# ============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Use MongoDB Atlas SRV URI in production)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/robopath?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/robopath

# JWT Authentication Secret (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS & CSRF Validation (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Public Frontend API Base URL (Optional for split deployments; leave empty when using unified server or Vite proxy)
# Example for split Render deployment: https://robopath-3d-api.onrender.com
VITE_API_BASE_URL=

# SMTP Configuration for Email OTP & Password Reset (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="RoboPath 3D <no-reply@robopath.edu>"

# Twilio Configuration for Phone-Number SMS OTP
TWILIO_ACCOUNT_SID=AC_replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000
TWILIO_VERIFY_SERVICE_SID=VA_optional_verify_service_sid
